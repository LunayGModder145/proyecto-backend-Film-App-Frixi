extends layout

block content
  include menu
  main.container
    h1 Mi perfil

    if error
      p.alert= error
    else if profile
      .panel
        p
          strong Nombre:
          span.js-profile-name= profile.name
        p
          strong Email:
          span.js-profile-email= profile.email
        p
          strong Rol:
          | #{profile.role === 'admin' ? 'Administrador' : 'Usuario'}

      //- public/js/profile.js lo envía con fetch a PUT /api/user
      //- y muestra los errores de validación sin salir de la página.
      form.form.panel.js-edit-profile(method="POST" action="/api/user")
        h2 Editar datos
        .alert.js-form-errors(role="alert" hidden)
        label(for="name") Nombre
        input#name(type="text" name="name" value=profile.name required maxlength="100")
        label(for="email") Email
        input#email(type="email" name="email" value=profile.email required maxlength="255")
        button.btn.btn--primary(type="submit") Guardar cambios
        p.card__msg.js-form-success(role="status")
    else
      p.empty No se ha encontrado tu usuario. Cierra sesión y vuelve a entrar.
