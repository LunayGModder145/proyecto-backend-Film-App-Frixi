extends layout

block content
  main.auth
    .auth__box
      h1.auth__logo 🎬 Film App
      h2 Crear cuenta

      if error
        p.alert= error

      form.form(method="POST" action="/api/signup")
        label(for="name") Nombre
        input#name(type="text" name="name" required)
        label(for="email") Email
        input#email(type="email" name="email" required placeholder="tu@email.com")
        label(for="password") Contraseña
        input#password(type="password" name="password" required minlength="6")
        button.btn.btn--primary.btn--block(type="submit") Registrarme

      p.divider o

      a.btn.btn--google.btn--block(href="/api/auth/google") G  Registrarme con Google

      p.auth__footer
        | ¿Ya tienes cuenta? 
        a(href="/login") Inicia sesión
